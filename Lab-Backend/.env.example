APP_ENV=development
APP_BASE_URL=http://localhost:5173
BIND_ADDR=127.0.0.1:3000
DATABASE_URL=postgres://ifa_runtime:local-only@127.0.0.1:5432/ifa_lab # pragma: allowlist secret -- local example
MIGRATION_DATABASE_URL=postgres://ifa_migrator:local-only@127.0.0.1:5432/ifa_lab # pragma: allowlist secret -- local example
OIDC_CLIENT_ID=replace-with-development-client-id
OIDC_CLIENT_SECRET=replace-on-server
OIDC_ISSUER=https://accounts.google.com
ALLOWED_EMAILS=dosen-utama@institution.example,admin-cadangan@example.com
# Akun Mahasiswa tambahan di luar pola NIM, dipisah koma. Kosongkan bila tidak ada.
STUDENT_EMAILS=
# Isi dari claim hd login institusi sah; kosong menolak akun institusi.
ITERA_WORKSPACE_DOMAIN=
# Required in production. Shown on the help page; never used for authentication.
SUPPORT_EMAIL=support@institution.example
